---
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
nodeRegistration:
  criSocket: "unix:///var/run/crio/crio.sock"
localAPIEndpoint:
  advertiseAddress: "{{ ansible_default_ipv4.address }}"
  bindPort: 6443
discovery:
  bootstrapToken:
    token: "{{ hostvars[groups.control_planes[0]].join_token.stdout }}"
    apiServerEndpoint: "{{ nlb_dns_name }}:6443"
    caCertHashes:
      - "sha256:{{ hostvars[groups.control_planes[0]].ca_hash.stdout }}"
controlPlane:
  certificateKey: "{{ hostvars[groups.control_planes[0]].certificate_key_raw.stdout_lines[-1] }}"
